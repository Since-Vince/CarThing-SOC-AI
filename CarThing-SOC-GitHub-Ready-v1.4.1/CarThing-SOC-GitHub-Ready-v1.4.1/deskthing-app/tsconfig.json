{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowJs": true, "resolveJsonModule": true,
    "noEmit": true, "lib": ["DOM", "ES2020"], "types": ["vite/client"]
  },
  "include": ["src", "server", "vite.config.ts"]
}
