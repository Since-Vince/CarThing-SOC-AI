# Copy this file to .env on your Ubuntu home lab and replace placeholders.
# Never commit the populated .env file.
CARTHING_API_KEY=CHANGE_ME
CARTHING_HOST=127.0.0.1
CARTHING_PORT=8765
CACHE_SECONDS=10

# Leave blank to disable the monitor, or use comma-separated exact Docker names.
MONITORED_CONTAINERS=
DISK_PATH=/

# Available backend modes: off, docker, file, indexer
WAZUH_MODE=off
WAZUH_DOCKER_CONTAINER=your-wazuh-manager-container
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
ALERT_WINDOW_HOURS=24

# Optional local AI. Install this model separately before enabling investigations.
SOC_AI_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434

# Leave unset unless you configure these integrations.
CORS_ORIGINS=
AUTH_LOG_PATH=
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_CA_BUNDLE=
